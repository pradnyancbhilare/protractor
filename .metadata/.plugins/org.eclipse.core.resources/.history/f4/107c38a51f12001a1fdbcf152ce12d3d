describe("My third test case: Club two cases", function(){
	
	beforeEach(function(){
		browser.get("https://juliemr.github.io/protractor-demo/");
		browser.manage().window().maximize();
		expect(browser.getTitle()).toEqual("Super Calculator");
		browser.sleep(5000);
		console.log("Test started");
	});
	
	it("Addition of two numbers", function(){
		console.log("Test 1");
		element(by.model("first")).sendKeys("4");
		element(by.model("second")).sendKeys("6");
		element(by.buttonText("Go!")).click();
		browser.sleep(5000);
		expect(element.all(by.repeater("result in memory"))).toBeTruthy();
		browser.sleep(5000);
	});
	
	xit("Multiplication of two numbers", function(){
		console.log("Test 2");
		element(by.model("first")).sendKeys("3");
		element.all(by.options("value for (key, value) in operators")).get(3).click();
		element(by.model("second")).sendKeys("6");
		element(by.buttonText("Go!")).click();
		browser.sleep(5000);
		expect(element.all(by.repeater("result in memory"))).toBeTruthy();
		browser.sleep(5000);		
	});
	
	it("Subtraction of two numbers", function(){
		console.log("Test 1");
		element(by.model("first")).sendKeys("6");
		element.all(by.options("value for (key, value) in operators")).get(4).click();
		element(by.model("second")).sendKeys("2");
		element(by.buttonText("Go!")).click();
		browser.sleep(5000);
		expect(element.all(by.repeater("result in memory"))).toBeTruthy();
		browser.sleep(5000);
	});
	
	
	afterEach(function(){
		console.log("Test completed");
	});

});