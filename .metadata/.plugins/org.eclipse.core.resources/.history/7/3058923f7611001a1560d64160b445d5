// Example of one Configuration file

var jasmine2HtmlReporer = require("protractor-jasmine2-html-reporter");

exports.config = {

	directConnect: true,

	// Capabilities to be passed to webdriver instance
	capabilities: {

		'browserName':'firefox'
	},

	// Framework to use. Jasmine is recommended.
	framework: 'jasmine',
	
	// Spec patterns are relative to the current working directory
	// when protractor is called.
	specs: ['myFirstTestCase.js', 'mySecondTestCase.js'],

	// Options to be passed to Jasmine
	jasmineNodeOpts: {

		defaultTimeoutInterval: 30000
	},
	
	// For reporting
	onPrepare: function(){
		jasmine.getEnv().addReporter(new jasmine2HtmlReporer({
			savePath: "./test/reports"
			
		}));
	},

}


